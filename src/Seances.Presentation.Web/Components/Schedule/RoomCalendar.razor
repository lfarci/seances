@using System.Globalization

<div class="room-calendar">
    <div class="calendar-scroll" role="region" tabindex="0"
         aria-label="Screening calendar for @Model.Cinema.Name on @(Model.Date.ToString("d MMMM yyyy", DisplayCulture)). Scroll to see more times and rooms.">
        <div class="calendar" style="@TimelineStyle">
            <div class="time-heading">Room / Time</div>
            <div class="time-axis" aria-hidden="true">
                @foreach (var tick in Timeline.Ticks.Where(tick => tick.OffsetMinutes % 60 == 0))
                {
                    <span class="time-cell" style="@FormattableString.Invariant($"left: calc((100% - 2rem) * {tick.OffsetMinutes / (double)Timeline.Minutes})")">@tick.Text</span>
                }
            </div>
            @foreach (var room in VisibleRooms)
            {
                var blocks = Timeline.ForRoom(Model.Screenings.Where(item => item.Room == room));
                <h3 class="room-heading">@room</h3>
                <section class="room-track" aria-label="@room" style="--lane-count: @blocks[0].LaneCount;">
                    @foreach (var block in blocks)
                    {
                        <div class="calendar-block" style="@BlockStyle(block)">
                            <ScreeningCard Screening="block.Showing" Selected="@(block.Showing.Screening.Id == SelectedScreening?.Screening.Id)" SameFilm="@block.Showing.IsOtherScreeningOf(SelectedScreening)" DetailsOpen="@(SelectedScreening is not null)" OnSelected="OnScreeningSelected" />
                        </div>
                    }
                </section>
            }
        </div>
    </div>
</div>

@code {
    private static readonly CultureInfo DisplayCulture = CultureInfo.GetCultureInfo("en-GB");
    private CalendarTimeline Timeline { get; set; } = null!;
    private IEnumerable<string> VisibleRooms => Model.Rooms.Where(room => Model.SelectedRoom.Length == 0 || room == Model.SelectedRoom);
    private string TimelineStyle => FormattableString.Invariant(
        $"--timeline-width: {Timeline.Minutes * .125}rem;");

    protected override void OnParametersSet()
    {
        Timeline = CalendarTimeline.Create(Model.Screenings);
    }

    private string BlockStyle(CalendarTimeline.Block block) => FormattableString.Invariant(
        $"left: calc((100% - 2rem) * {block.OffsetMinutes / (double)Timeline.Minutes}); width: calc((100% - 2rem) * {block.DurationMinutes / Timeline.Minutes}); top: calc({block.Lane} * var(--room-lane-height));");

    [Parameter, EditorRequired]
    public SchedulePageModel Model { get; set; } = null!;

    [Parameter]
    public SchedulePageModel.ShowingView? SelectedScreening { get; set; }

    [Parameter]
    public EventCallback<SchedulePageModel.ShowingView> OnScreeningSelected { get; set; }

}
