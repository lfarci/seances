<ol class="mobile-showings" aria-label="Screenings in time and room order">
    @foreach (var screening in Screenings)
    {
        <li>
            <ScreeningCard Screening="screening" Mobile="true" Selected="@(screening.Screening.Id == SelectedScreening?.Screening.Id)" DetailsOpen="@(SelectedScreening is not null)" OnSelected="OnScreeningSelected" />
        </li>
    }
</ol>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SchedulePageModel.ShowingView> Screenings { get; set; } = [];

    [Parameter]
    public SchedulePageModel.ShowingView? SelectedScreening { get; set; }

    [Parameter]
    public EventCallback<SchedulePageModel.ShowingView> OnScreeningSelected { get; set; }

}
