@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="details-resizer" role="separator" tabindex="0" aria-orientation="vertical"
     aria-label="Resize screening details" aria-controls="screening-details"
     aria-valuemin="0" aria-valuemax="25" aria-valuenow="0"
     aria-description="Use Left and Right arrows to resize. Home and End select the minimum and maximum widths. Double-click to reset."
     title="Drag to resize details, or use the arrow keys. Double-click to reset."
     @ref="_handle"></div>

@code {
    private ElementReference _handle;
    private IJSObjectReference? _module;
    private IJSObjectReference? _resizer;
    private Task? _initialization;
    private bool _disposed;

    protected override Task OnAfterRenderAsync(bool firstRender) => firstRender
        ? _initialization = InitializeAsync()
        : Task.CompletedTask;

    private async Task InitializeAsync()
    {
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/details-resizer.js");
        if (!_disposed)
            _resizer = await _module.InvokeAsync<IJSObjectReference>("create", _handle);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_initialization is not null)
                await _initialization;
            if (_resizer is not null)
            {
                await _resizer.InvokeVoidAsync("dispose");
                await _resizer.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
