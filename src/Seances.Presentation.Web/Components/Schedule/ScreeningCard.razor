<article class="@(Mobile ? "mobile-showing" : "showing")">
    <p class="@(Mobile ? "mobile-time" : "showing-time")">
        <time datetime="@Screening.Screening.StartsAt.ToString("O")">@Screening.StartText</time>
    </p>
    <h3>@Screening.Film.Title</h3>
    <p class="@(Mobile ? "mobile-room" : "showing-room")">@Screening.Room</p>
    <p class="showing-meta">@Screening.Screening.VersionLabel@if (!string.IsNullOrWhiteSpace(Screening.Screening.Format)) { <span> · @Screening.Screening.Format</span> }</p>
    <details>
        <summary>More details</summary>
        <dl>
            <dt>Version</dt><dd>@Screening.Screening.VersionLabel</dd>
            <dt>Format</dt><dd>@(Screening.Screening.Format ?? "Unavailable")</dd>
            <dt>Room</dt><dd>@Screening.Room</dd>
            <dt>Runtime</dt><dd>@Screening.RuntimeText</dd>
            <dt>Estimated finish</dt><dd>@Screening.FinishText · @Screening.FinishDescription@if (Screening.Finish.Label is not null) { <span> · @Screening.Finish.Label</span> }</dd>
            @if (Screening.Screening.SourceStatus is not null)
            {
                <dt>Source status:</dt><dd>@($" {Screening.Screening.SourceStatus}")</dd>
            }
        </dl>
        @if (Screening.Screening.BookingUrl is not null)
        {
            <a href="@Screening.Screening.BookingUrl" rel="external">Book online</a>
        }
        else
        {
            <p>Booking link unavailable.</p>
        }
    </details>
</article>

@code {
    [Parameter, EditorRequired]
    public SchedulePageModel.ShowingView Screening { get; set; } = null!;

    [Parameter]
    public bool Mobile { get; set; }
}
