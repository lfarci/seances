<div class="filter-field cinema-filter">
    <label for="calendar-cinema">Cinema</label>
    <select id="calendar-cinema" name="cinema" value="@Model.Cinema.Id" @onchange="ChangeCinema">
        @foreach (var cinema in Model.Cinemas)
        {
            <option value="@cinema.Id" selected="@(cinema.Id == Model.Cinema.Id)">@cinema.Name</option>
        }
    </select>
</div>

@code {
    [Parameter, EditorRequired]
    public SchedulePageModel Model { get; set; } = null!;

    [Parameter]
    public EventCallback<string> OnChanged { get; set; }

    private Task ChangeCinema(ChangeEventArgs args) => OnChanged.InvokeAsync(args.Value?.ToString() ?? Model.Cinema.Id);

}
