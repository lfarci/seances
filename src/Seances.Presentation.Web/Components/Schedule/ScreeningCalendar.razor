@if (!Model.HasCoverage)
{
    <p class="empty-state" role="status">The programme is not published for this cinema and date.</p>
}
else if (Model.Screenings.Count == 0)
{
    <p class="empty-state" role="status">No screenings were listed in the successful check.</p>
}
else
{
    <div class="calendar-workspace">
        <div class="calendar-content">
            <RoomCalendar Model="Model" SelectedScreening="SelectedScreening" OnScreeningSelected="OnScreeningSelected" />
            <MobileScreeningList Screenings="Model.Screenings" SelectedScreening="SelectedScreening" OnScreeningSelected="OnScreeningSelected" />
        </div>
        <ScreeningDetailsPane Screening="SelectedScreening" OnScreeningClosed="OnScreeningClosed" />
    </div>
}

@code {
    [Parameter, EditorRequired]
    public SchedulePageModel Model { get; set; } = null!;

    [Parameter]
    public SchedulePageModel.ShowingView? SelectedScreening { get; set; }

    [Parameter]
    public EventCallback<SchedulePageModel.ShowingView> OnScreeningSelected { get; set; }

    [Parameter]
    public EventCallback OnScreeningClosed { get; set; }

}
