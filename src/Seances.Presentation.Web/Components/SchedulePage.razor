@page "/"
@inject LocalSnapshotStore SnapshotStore
@inject SchedulePageModelFactory PageModelFactory
@inject NavigationManager Navigation

<main>
    @if (_model is null)
    {
        <header>
            <h1>Find a screening</h1>
            <p class="intro">Browse showtimes for Brussels cinemas.</p>
        </header>
        <section class="notice" role="status" aria-live="polite">
            <h2>Schedule unavailable</h2>
            <p>No successful local refresh is available yet.</p>
        </section>
    }
    else
    {
        <header class="page-heading">
            <h1>Find a screening</h1>
            <p class="intro">Browse showtimes by cinema, room, and time.</p>
        </header>

        <section class="schedule" aria-labelledby="schedule-heading">
            <div class="schedule-toolbar">
                <div>
                    <h2 id="schedule-heading">@_model.Cinema.Name</h2>
                    <p class="address">@_model.Cinema.Address</p>
                </div>
                <p class="freshness">Schedule checked @_model.CheckedAtText Brussels time</p>
            </div>

            <ScheduleFilters Model="_model" />

            <ScreeningCalendar Model="_model" SelectedScreening="_selectedScreening" OnScreeningSelected="SelectScreening" OnScreeningClosed="CloseScreening" />
        </section>
    }
</main>

@code {
    private SchedulePageModel? _model;
    private SchedulePageModel.ShowingView? _selectedScreening;

    private void SelectScreening(SchedulePageModel.ShowingView screening) =>
        _selectedScreening = _selectedScreening?.Screening.Id == screening.Screening.Id ? null : screening;

    private void CloseScreening() => _selectedScreening = null;
    protected override async Task OnInitializedAsync()
    {
        var snapshot = await SnapshotStore.ReadAsync();
        if (snapshot is not null)
            _model = PageModelFactory.Create(snapshot, new Uri(Navigation.Uri), DateTimeOffset.UtcNow);
    }
}
